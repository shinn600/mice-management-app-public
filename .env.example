# Database (SQLite)
DATABASE_URL="file:./dev.db"

# NextAuth secret (generate with: openssl rand -hex 32)
AUTH_SECRET="your-secret-here"

# Board notification email (optional — if sending credentials are unset, notifications are skipped)
# All three are fallback defaults, used only if the matching value hasn't been set from the
# admin-only Settings page (/settings) — see AppSetting keys smtpUser / smtpPass / boardNotifyEmail.
# SMTP_USER / SMTP_PASS: Gmail address + App Password (https://myaccount.google.com/apppasswords)
# BOARD_NOTIFY_EMAIL: default recipient address
SMTP_USER=""
SMTP_PASS=""
BOARD_NOTIFY_EMAIL=""
